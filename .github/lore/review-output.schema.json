{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "body", "path", "line"],
        "properties": {
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": ["string", "null"],
            "minLength": 1,
            "pattern": "\\S"
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    }
  }
}
