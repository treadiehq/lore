{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build:packages && pnpm --filter @lore-co/api build"
  },
  "deploy": {
    "preDeployCommand": [
      "pnpm --filter @lore-co/database db:migrate"
    ],
    "startCommand": "NODE_ENV=production node apps/api/dist/main.js",
    "healthcheckPath": "/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
