# Local source stack. `project:start` replaces the token placeholder automatically.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lore
API_PORT=3004
API_BIND_ADDRESS=127.0.0.1
API_JSON_BODY_LIMIT=2mb
API_RATE_LIMIT_PER_MINUTE=120
LORE_API_URL=http://localhost:3004
LORE_WORKSPACE_TOKEN=replace-with-a-long-random-workspace-token
LORE_WORKSPACE_ORGANIZATION=local
LORE_WORKSPACE_NAME=local

# Optional dashboard. Headless deployments can omit these.
NUXT_PORT=3002
NUXT_BIND_ADDRESS=127.0.0.1
NUXT_ORIGIN=http://localhost:3002
NUXT_PUBLIC_LORE_CONNECTOR_API_URL=http://localhost:3004
NUXT_PUBLIC_LORE_INSTALL_URL=https://raw.githubusercontent.com/treadiehq/lore/main/scripts/install.sh
NUXT_AUTH_COOKIE_NAME=lore_session
NUXT_AUTH_COOKIE_SECURE=false
# Account-free local dashboard authentication.
AUTH_MODE=local_owner
LORE_OWNER_BOOTSTRAP_TOKEN=replace-with-a-separate-256-bit-owner-bootstrap-token
# Used only when AUTH_MODE=magic_link.
AUTH_EMAIL_MODE=local
AUTH_WEB_ORIGIN=http://localhost:3002
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_PASSWORD_RESET_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30

# Canonical production Compose. Copy this file to a deployment-specific env
# file, use a URL-safe random password/token, and run:
# docker compose -f docker-compose.yml --env-file /path/to/lore.env up -d
# LORE_IMAGE_TAG=0.1.3
# LORE_API_IMAGE=ghcr.io/treadiehq/lore-api
# LORE_WEB_IMAGE=ghcr.io/treadiehq/lore-web
# POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
# API_PORT=3001
# NUXT_PORT=3000
# LORE_WORKSPACE_TOKEN=replace-with-at-least-24-random-characters
# LORE_WORKSPACE_ORGANIZATION=example
# LORE_WORKSPACE_NAME=Example
#
# The API image outside Compose also requires a PostgreSQL URL:
# DATABASE_URL=postgresql://lore:password@postgres.example.com:5432/lore
#
# Headless production disables browser authentication:
# AUTH_MODE=disabled
#
# Account-free production uses a separate 256-bit bootstrap secret:
# AUTH_MODE=local_owner
# LORE_OWNER_BOOTSTRAP_TOKEN=replace-with-64-random-hex-characters
# AUTH_WEB_ORIGIN=https://lore.example.com
# NUXT_ORIGIN=https://lore.example.com
#
# A production dashboard requires matching HTTPS origins and Resend:
# AUTH_MODE=magic_link
# NUXT_ORIGIN=https://lore.example.com
# NUXT_PUBLIC_LORE_CONNECTOR_API_URL=https://api.lore.example.com
# NUXT_AUTH_COOKIE_SECURE=true
# AUTH_EMAIL_MODE=resend
# AUTH_WEB_ORIGIN=https://lore.example.com
# AUTH_EMAIL_FROM="Lore <auth@example.com>"
# RESEND_API_KEY=

# Optional extraction. The heuristic provider needs no credentials.
EXTRACTOR_PROVIDER=heuristic
EXTRACTOR_MIN_CONFIDENCE=0.8
# EXTRACTOR_MODEL=
# EXTRACTOR_BASE_URL=
# EXTRACTOR_API_KEY=

# Optional semantic retrieval. Without an API key, auto mode remains lexical.
RETRIEVAL_MODE=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_MS=5000
SEMANTIC_MIN_SIMILARITY=0.65
CONTEXT_MAX_ITEMS=10
CONTEXT_MAX_CHARACTERS=12000
CONTEXT_MAX_ESTIMATED_TOKENS=4000

# Optional Devin support.
DEVIN_POLLING_ENABLED=false
# DEVIN_API_KEY=
# DEVIN_ORG_ID=
# DEVIN_REPOSITORY_ALLOWLIST=owner/repository
DEVIN_POLL_INTERVAL_MS=15000
DEVIN_REQUEST_TIMEOUT_MS=10000
DEVIN_POLL_BATCH_SIZE=25

# Credential-gated OpenCode live acceptance. Never commit real values.
# RUN_OPENCODE_LIVE_TESTS=RUN
# LORE_DASHBOARD_SESSION_TOKEN=
# OPENCODE_ACCEPTANCE_REPO=owner/test-repository
# OPENCODE_ACCEPTANCE_MODEL=provider/model
# OPENCODE_ACCEPTANCE_MAX_COST_USD=0.50
