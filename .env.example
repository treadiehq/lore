# Local stack. project:start replaces the token placeholder automatically.
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lore
API_PORT=3004
LORE_API_URL=http://localhost:3004
LORE_WORKSPACE_TOKEN=replace-with-a-long-random-workspace-token
LORE_WORKSPACE_ORGANIZATION=local
# The dashboard/learning wiki is optional. Headless deployments can omit NUXT
# variables and run project:headless:start with PostgreSQL, migrations, and API.
NUXT_PORT=3002
NUXT_PUBLIC_LORE_CONNECTOR_API_URL=http://localhost:3004
NUXT_PUBLIC_LORE_INSTALL_URL=https://raw.githubusercontent.com/treadiehq/lore/main/scripts/install.sh

# If NUXT_PORT changes, set both origins to the matching public URL.
# NUXT_ORIGIN=http://localhost:3002
# AUTH_WEB_ORIGIN=http://localhost:3002

# Production email delivery. Local mode prints passwordless links in API logs.
# AUTH_EMAIL_MODE=resend
# AUTH_EMAIL_FROM="Lore <auth@example.com>"
# RESEND_API_KEY=
# AUTH_MAGIC_LINK_TTL_MINUTES=15
# AUTH_SESSION_TTL_DAYS=30
# NUXT_AUTH_COOKIE_NAME=lore_session
# NUXT_AUTH_COOKIE_SECURE=true

# Optional Devin transcript polling. Use a dedicated service user and allowlist.
# DEVIN_POLLING_ENABLED=true
# DEVIN_API_KEY=
# DEVIN_ORG_ID=
# DEVIN_REPOSITORY_ALLOWLIST=owner/repository
# DEVIN_POLL_INTERVAL_MS=15000
# DEVIN_REQUEST_TIMEOUT_MS=10000
# DEVIN_POLL_BATCH_SIZE=25
# DEVIN_CREATE_AS_USER_ID=
# DEVIN_MESSAGE_AS_USER_ID=
# DEVIN_MAX_ACU_LIMIT=2
# DEVIN_REVIEW_MAX_ACU_LIMIT=2
# DEVIN_ACCEPTANCE_REPO=owner/test-repository
# DEVIN_ACCEPTANCE_TIMEOUT_MS=1200000
# DEVIN_ACCEPTANCE_POLL_INTERVAL_MS=10000
# DEVIN_CAPTURE_TIMEOUT_MS=120000

# Real native Claude/Codex acceptance. This uses connected native hooks,
# persistent resumed sessions, real vendor calls, and no requested tool use.
# RUN_NATIVE_AGENT_LIVE_TESTS=1
# NATIVE_AGENT_ACCEPTANCE_REPO=owner/test-repository
# NATIVE_AGENT_COMMAND_TIMEOUT_MS=180000
# NATIVE_AGENT_CAPTURE_TIMEOUT_MS=120000
# NATIVE_AGENT_POLL_INTERVAL_MS=2000
# NATIVE_AGENT_CLAUDE_MAX_BUDGET_USD=0.50
# NATIVE_AGENT_CLAUDE_MODEL=haiku
# NATIVE_AGENT_CODEX_MODEL=

# Explicitly gated real Claude -> Devin -> Codex/Claude chain. The gate value
# is RUN (not 1). Devin has a hard ACU cap and Claude has a per-call spend cap.
# RUN_THREE_AGENT_CHAIN_LIVE_TESTS=RUN
# THREE_AGENT_ACCEPTANCE_REPO=owner/test-repository
# THREE_AGENT_COMMAND_TIMEOUT_MS=180000
# THREE_AGENT_CAPTURE_TIMEOUT_MS=120000
# THREE_AGENT_ACTIVITY_TIMEOUT_MS=120000
# THREE_AGENT_DEVIN_TIMEOUT_MS=1200000
# THREE_AGENT_POLL_INTERVAL_MS=5000
# THREE_AGENT_DEVIN_MAX_ACU=2
# THREE_AGENT_CLAUDE_MAX_BUDGET_USD=0.50
# THREE_AGENT_CLAUDE_MODEL=haiku
# THREE_AGENT_CODEX_MODEL=

# Explicitly gated GitHub PR live acceptance. The target is never configured
# implicitly; its Lore workflows, labels, Actions secret names, and variable
# names must already exist. Target Actions secrets are LORE_WORKSPACE_TOKEN plus
# OPENAI_API_KEY and/or DEVIN_API_KEY; target variables include LORE_API_URL,
# LORE_CLI_VERSION, optional LORE_CLI_REPOSITORY, and DEVIN_ORG_ID for Devin.
# Review jobs need contents:read and pull-requests:write.
# RUN_GITHUB_PR_LIVE_TESTS=1
# GH_TOKEN=
# GITHUB_PR_LIVE_REPO=owner/test-repository
# GITHUB_PR_LIVE_BASE_BRANCH=main
# GITHUB_PR_LIVE_PROVIDERS=codex,devin
# GITHUB_PR_LIVE_CLI_REPOSITORY=treadiehq/lore
# GITHUB_PR_LIVE_CLI_VERSION=v0.1.0
# GITHUB_PR_LIVE_CLEANUP=always
# GITHUB_PR_LIVE_REVIEW_TIMEOUT_MS=1800000
# GITHUB_PR_LIVE_CORRECTION_TIMEOUT_MS=600000
# GITHUB_PR_LIVE_LEARNING_TIMEOUT_MS=120000
# GITHUB_PR_LIVE_POLL_INTERVAL_MS=10000

# Optional provider-assisted extraction.
# EXTRACTOR_PROVIDER=hybrid
# EXTRACTOR_MODEL=gpt-4.1-mini
# EXTRACTOR_BASE_URL=https://api.openai.com/v1
# EXTRACTOR_API_KEY=

# Optional semantic retrieval. RETRIEVAL_MODE defaults to auto and enables
# hybrid retrieval when this key is configured.
# EMBEDDING_API_KEY=

# Optional database-test overrides. Leave unset for normal test runs.
# RUN_DATABASE_TESTS=1
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/lore_test
